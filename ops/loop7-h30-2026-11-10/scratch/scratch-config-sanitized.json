{
 "agents": {
  "defaults": {
   "model": {
    "primary": "openai/gpt-6-luna"
   },
   "utilityModel": "openai/gpt-6-luna",
   "systemAgent": {
    "agentId": "main"
   },
   "heartbeat": {
    "agentId": "main"
   },
   "subagents": {
    "maxSpawnDepth": 1,
    "maxChildrenPerAgent": 2,
    "runTimeoutSeconds": 120
   },
   "models": {
    "openai/gpt-6-luna": {
     "agentRuntime": {
      "id": "openclaw"
     }
    }
   }
  },
  "ownership": "explicit",
  "entries": {
   "main": {
    "workspace": "~/scratch30/wsg/main",
    "agentDir": "~/scratch30/gw/agents/main/agent"
   },
   "coo": {
    "name": "coo",
    "workspace": "~/scratch30/wsg/coo",
    "agentDir": "~/scratch30/gw/agents/coo/agent",
    "identity": {
     "name": "COO",
     "emoji": ":compass:"
    },
    "model": "openai/gpt-6-luna",
    "tools": {
     "agentToAgent": {
      "send": [
       "cho",
       "cos",
       "cfo"
      ]
     }
    }
   },
   "cos": {
    "name": "cos",
    "workspace": "~/scratch30/wsg/cos",
    "agentDir": "~/scratch30/gw/agents/cos/agent",
    "identity": {
     "name": "CoS",
     "emoji": ":spiral_calendar_pad:"
    },
    "model": "openai/gpt-6-luna",
    "tools": {
     "agentToAgent": {
      "send": [
       "coo",
       "cho"
      ]
     },
     "fs": {
      "workspaceOnly": true
     },
     "alsoAllow": [
      "read",
      "write",
      "edit"
     ]
    }
   },
   "clo": {
    "name": "clo",
    "workspace": "~/scratch30/wsg/clo",
    "agentDir": "~/scratch30/gw/agents/clo/agent",
    "identity": {
     "name": "CLO",
     "emoji": ":clapper:"
    },
    "model": "openai/gpt-6-luna",
    "tools": {
     "agentToAgent": {
      "send": [
       "coo",
       "cos"
      ]
     },
     "fs": {
      "workspaceOnly": true
     },
     "alsoAllow": [
      "read",
      "write",
      "edit"
     ]
    }
   }
  }
 },
 "tools": {
  "profile": "messaging",
  "agentToAgent": {
   "enabled": true,
   "allow": [
    "coo",
    "cho",
    "cos",
    "cfo",
    "clo"
   ]
  },
  "sessions": {
   "visibility": "agent"
  }
 },
 "meta": {
  "migrations": {
   "modelPolicyAllowlist": true,
   "utilityModelSeparation": true
  },
  "lastTouchedVersion": "2026.10.5"
 },
 "talk": {
  "agentId": "main"
 },
 "session": {
  "reset": {
   "mode": "daily",
   "atHour": 4
  }
 },
 "memory": {
  "search": {
   "enabled": false
  }
 },
 "commands": {},
 "plugins": {
  "entries": {
   "anthropic": {
    "config": {
     "sessionCatalog": {
      "enabled": false
     }
    }
   },
   "codex": {
    "config": {
     "sessionCatalog": {
      "enabled": false
     }
    }
   },
   "memory-core": {
    "config": {
     "dreaming": {
      "enabled": false
     }
    },
    "enabled": true
   },
   "openai": {
    "enabled": true
   }
  }
 },
 "gateway": {
  "mode": "local",
  "port": 19931,
  "bind": "loopback",
  "auth": {
   "mode": "token",
   "token": "<redacted>"
  }
 }
}