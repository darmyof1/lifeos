+class AgentNameInLine(unittest.TestCase):
+    """Loop 7 (APR-0126): the same function serves the CHO, CoS and CFO lines; the default stays the COO."""
+    def test_default_text_is_unchanged_for_the_coo(self):
+        st, det = status([], NOW)
+        self.assertEqual((st, det), ("INFO", "no COO compaction run yet (first one is due at 05:25 AST)"))
+
+    def test_other_agent_names_and_due_times(self):
+        st, det = status([], NOW, "CHO", "05:30")
+        self.assertEqual(st, "INFO")
+        self.assertIn("CHO", det); self.assertIn("05:30", det)
+        for who in ("CHO", "COS", "CFO"):
+            self.assertEqual(status([line("2026-11-10 05:30:01", "compacted") + " agent=x"], NOW + 3600, who)[0], "PASS")
+            self.assertEqual(status([line("2026-11-08 05:30:01", "compacted")], NOW, who)[0], "WARN")
+            self.assertEqual(status([line("2026-11-10 05:30:01", "error")], NOW + 3600, who)[0], "WARN")
+            self.assertIn(who, status([line("2026-11-08 05:30:01", "compacted")], NOW, who)[1])
+
+    def test_new_log_lines_with_agent_at_the_end_still_parse(self):
+        st, det = status([line("2026-11-10 05:25:01", "compacted") + " agent=coo"], NOW + 60)
+        self.assertEqual(st, "PASS")
+
+
 if __name__ == "__main__":
     unittest.main()
